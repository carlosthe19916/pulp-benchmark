# Committed config template -- NO secrets here. Copy to .env.local (gitignored) and fill in
# real values, or export any of these in your shell (your shell environment always wins).
#
#   cp .env .env.local   &&   $EDITOR .env.local
#
# Precedence when run-test.sh loads config: shell environment > .env.local > .env

# Base URL of the stage pulp API, e.g. https://packages.stage.redhat.com
BASE_URL=https://packages.stage.redhat.com

# Credentials for authenticated endpoints (e.g. repositories). Leave blank for the
# unauthenticated "status" endpoint.
PULP_USER=
PULP_PASS=
