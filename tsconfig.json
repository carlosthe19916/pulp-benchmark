{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true, // k6 requires the .ts extension on local imports
    "strict": true,
    "noEmit": true,
    "types": ["k6"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["k6-scripts/**/*.ts"]
}
